# ---- App ----
APP_ENV=local
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database ----
# Matches docker-compose.yml defaults. Never commit a real .env file.
DATABASE_URL=postgresql+psycopg://moin:moin@localhost:5432/moinsystems_chatbot

# ---- LLM provider (adapter picks one at runtime) ----
# "openai" or "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Embeddings ----
EMBEDDING_MODEL=text-embedding-3-small

# ---- Email ----
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
LEAD_EMAIL_TO=info@moinsystemsai.com

# ---- Security ----
APP_SECRET=change-me-to-a-random-64-char-string

# ---- Misc ----
RATE_LIMIT=60/minute


OPENAI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
